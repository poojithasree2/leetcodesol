class Solution:
    def countSubmatrices(self, grid: List[List[int]], k: int) -> int:
        m,n = len(grid),len(grid[0])

        # calculating prefix horzontally and vertically
        for i in range(m):
            for j in range(1,n):
                grid[i][j] += grid[i][j-1]
        for i in range(1,m):
            for j in range(n):
                grid[i][j] += grid[i-1][j]
        
        # counting matrix with sum <= k
        res = 0
        for i in range(m):
            for j in range(n):
                if grid[i][j] <= k:
                    res += 1
        return res
